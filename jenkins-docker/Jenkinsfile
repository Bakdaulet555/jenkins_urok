def runSbt(String args) {
    if (isUnix()) {
        sh "sbt -batch ${args}"
    } else {
        bat "call sbt -batch ${args}"
    }
}

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                dir('jenkins-docker') {
                    script {
                        runSbt('clean compile')
                    }
                }
            }
        }

        stage('Static Analysis') {
            steps {
                dir('jenkins-docker') {
                    script {
                        runSbt('scalastyle')
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('jenkins-docker') {
                    script {
                        runSbt('test')
                    }
                }
            }
            post {
                always {
                    junit 'jenkins-docker/**/target/test-reports/*.xml'
                }
            }
        }

        stage('Package') {
            when {
                branch 'main'
            }
            steps {
                dir('jenkins-docker') {
                    script {
                        runSbt('assembly')
                    }

                    stash name: 'docker-input',
                          includes: 'Dockerfile,.dockerignore,target/scala-2.13/akka-iot-service.jar'
                }
            }
        }

        stage('Package & Push Docker Image') {
            when {
                beforeAgent true
                allOf {
                    branch 'main'
                    expression {
                        currentBuild.currentResult == 'SUCCESS'
                    }
                }
            }

            agent {
                label 'docker-linux'
            }

            steps {
                unstash 'docker-input'

                script {
                    if (!params.IMAGE_REPOSITORY?.trim()) {
                         error('Set IMAGE_REPOSITORY')
                    }

                    def image = docker.build(
                        "${params.IMAGE_REPOSITORY}:${env.BUILD_NUMBER}"
                    )

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub-credentials-id'
                    ) {
                        image.push()
                        image.push('latest')
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                if (params.NOTIFY_TO?.trim()) {
                    mail(
                        to: params.NOTIFY_TO,
                        subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: "Build failed. Console: ${env.BUILD_URL}console"
                    )
                } else {
                    echo 'Build FAILED. NOTIFY_TO is not configured.'
                }
            }
        }
    }
}
